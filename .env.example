# Backend address. /api/v1/* is forwarded here (read at build time).
BACKEND_URL=http://localhost:5000

# Keep as /api/v1 unless the browser should call the backend directly.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional branding and support details shown on the site.
# NEXT_PUBLIC_APP_NAME=CourierGo
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_PHONE=

# Optional: without it the Google sign-in button is hidden.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: credentials for the one-click demo login buttons.
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
# NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=
# NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD=
# NEXT_PUBLIC_DEMO_RIDER_EMAIL=
# NEXT_PUBLIC_DEMO_RIDER_PASSWORD=

# Optional: delivery fee used by the estimator. Must match the backend values.
# NEXT_PUBLIC_BASE_DELIVERY_FEE=50
# NEXT_PUBLIC_PER_KG_FEE=15
# NEXT_PUBLIC_PER_KM_FEE=10

# Optional: AI assistant (server-side only, never exposed to the browser).
# The chat button only appears when this key is set at build time.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
